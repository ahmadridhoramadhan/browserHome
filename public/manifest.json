{
  "manifest_version": 3,
  "name": "Custom Home Browser",
  "version": "1.0.0",
  "description": "Beranda Chrome kustom interaktif dengan jendela widget bebas geser, jam, cuaca, jadwal sholat, to-do list, dan pintasan aplikasi.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Home"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
